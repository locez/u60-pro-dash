import { Palette, Label, GlassPanel } from "components.slint";

export component WifiCard inherits GlassPanel {
    in property <image> qr;
    in property <bool> ready;
    in property <string> ssid;
    in property <string> band;
    in property <string> password;
    in property <string> message;
    in property <bool> protected;
    in property <bool> revealed;
    in property <bool> switchable;
    callback expand;
    callback toggle-password;
    callback switch-band;
    translucent: true;
    height: max(120px, password-row.y + password-row.height + 8px);
    min-width: 296px; horizontal-stretch: 1; vertical-stretch: 0;
    Rectangle {
        x: 8px; y: 8px; width: 104px; height: 104px;
        background: root.ready ? #ffffff : Palette.bg;
        border-radius: root.ready ? 0px : 6px;
        if root.ready: Image { source: root.qr; width: 104px; height: 104px; image-fit: contain; }
        if !root.ready: Label { text: "Wi-Fi"; horizontal-alignment: center; vertical-alignment: center; color: Palette.muted; font-size: 23px; }
        TouchArea { enabled: root.ready; accessible-role: button; accessible-label: @tr("放大连接二维码"); clicked => { root.expand(); } }
    }
    // Fixed QR and detail columns; a long SSID never negotiates QR width.
    Rectangle {
        x: 124px; y: 42px; width: parent.width - 132px; height: 22px;
        Label { text: root.band; width: parent.width - (root.switchable ? 18px : 0px); font-size: 12px; vertical-alignment: center; color: root.switchable ? Palette.accent-ink : Palette.muted; }
        if root.switchable: Label { text: "›"; width: 16px; x: parent.width - 16px; font-size: 22px; vertical-alignment: center; color: Palette.accent-ink; }
        TouchArea { y: -4px; height: 44px; enabled: root.switchable; accessible-role: button; accessible-label: @tr("切换 Wi-Fi 频段"); clicked => { root.switch-band(); } }
    }
    Label {
        x: 124px; y: 8px; width: parent.width - 132px; height: 34px;
        text: root.ready ? root.ssid : root.message; font-size: 15px; font-weight: 600;
        wrap: char-wrap; overflow: elide; vertical-alignment: center;
    }
    password-row := Rectangle {
        x: 124px; y: 68px; width: parent.width - 132px;
        height: max(44px, credential.preferred-height + 12px); visible: root.ready;
        credential := Label {
            x: 0px; y: (parent.height - self.height) / 2;
            width: parent.width - (root.protected ? 46px : 0px); height: self.preferred-height;
            text: !root.ready ? "" : root.protected && !root.revealed ? "********" : root.password;
            font-size: 14px; wrap: char-wrap; overflow: clip; horizontal-alignment: left;
        }
        if root.protected: Rectangle {
            x: parent.width - 44px; y: 0px; width: 44px; height: 44px;
            border-radius: 7px; background: eye.pressed ? Palette.line : Palette.surface;
            Path {
                x: 10px; y: 14px; width: 24px; height: 16px;
                commands: "M 1 8 Q 12 -5 23 8 Q 12 21 1 8 Z M 15 8 A 3 3 0 1 1 9 8 A 3 3 0 1 1 15 8";
                stroke: Palette.accent-ink; stroke-width: 1.5px;
            }
            if !root.revealed: Path {
                x: 10px; y: 10px; width: 24px; height: 24px;
                commands: "M 2 2 L 22 22"; stroke: Palette.accent-ink; stroke-width: 1.5px;
            }
            eye := TouchArea { accessible-role: button; accessible-label: root.revealed ? @tr("隐藏密码") : @tr("显示密码"); clicked => { root.toggle-password(); } }
        }
    }
}
