import { Palette, Label, TapButton, MenuRow, Stat, Brightness, TrafficPanel } from "components.slint";
import { LockScreen, PinPad } from "lock.slint";
import { TextEditor } from "editor.slint";
import "../assets/U60Sans.ttf";
import "../assets/U60Hangul.ttf";
export { Palette }
export struct MenuEntry { id: string, title: string, subtitle: string, tag: string }
export struct Reading { label: string, value: string }
export struct FeatureAction { label: string, enabled: bool }
export struct FeatureInput { index: int, title: string, subtitle: string, tag: string }

export component Screen inherits Window {
    width: 320px; height: 480px;
    title: @tr("U60 · 原生屏幕预览");
    default-font-family: root.language == "ko" ? "U60 Hangul" : "U60 Sans";
    default-font-size: 14px;
    background: Palette.bg;
    in-out property <int> tab: 0;
    // 0 overview, 1 menu, 2 detail, 3 appearance, 4 Tailscale network.
    in-out property <int> view: 0;
    in-out property <string> heading: @tr("随身网络");
    in-out property <string> kicker: "01 / OVERVIEW";
    in-out property <bool> can-back: false;
    in-out property <[MenuEntry]> entries;
    in-out property <[Reading]> readings;
    in-out property <[string]> actions;
    in-out property <[FeatureInput]> feature-fields;
    in-out property <[FeatureAction]> feature-actions;
    in-out property <bool> feature-busy;
    in-out property <string> feature-notice;
    in-out property <image> feature-qr;
    in-out property <string> feature-qr-caption;
    in-out property <string> feature-content;
    in-out property <bool> feature-has-qr;
    in-out property <bool> choice-visible;
    in-out property <string> choice-title;
    in-out property <[MenuEntry]> choices;
    in-out property <bool> confirm-visible;
    in-out property <string> confirm-body;
    in-out property <string> confirm-phrase;
    in-out property <string> confirm-word;
    callback feature-edit(int);
    callback feature-action(int);
    callback feature-refresh;
    callback choose(int);
    callback choice-cancel;
    callback confirm-accept;
    callback confirm-cancel;
    in-out property <string> description;
    in-out property <string> note;
    in-out property <bool> asleep: false;
    in-out property <int> brightness: 70;
    in-out property <string> sleep-label: @tr("60 秒");
    in-out property <string> accent-hex: "#2563eb";
    in-out property <string> language: "zh-Hans";
    callback set-language(string);
    in-out property <bool> demo: true;
    in-out property <string> connection-label: @tr("演示");
    in-out property <string> network-mode: "5G";
    in-out property <string> radio-label: "5G SA · n78";
    in-out property <string> signal-strength: "−86";
    in-out property <string> client-count: "3";
    in-out property <string> traffic-total: "2.38 GB";
    in-out property <string> tailnet-status: @tr("已连接");
    in-out property <[Reading]> tailnet-readings;
    in-out property <string> probe-target;
    in-out property <string> probe-note;
    in-out property <bool> editor-visible;
    in-out property <string> editor-title;
    in-out property <string> editor-hint;
    in-out property <string> editor-error;
    in-out property <string> editor-value;
    in-out property <bool> editor-secret;
    in-out property <bool> editor-multiline;
    in-out property <int> editor-layout;
    callback edit(string);
    callback editor-key(string);
    callback editor-submit;
    callback editor-cancel;
    callback refresh;
    callback agent-forget;
    in-out property <string> battery: "82%";
    in-out property <bool> network-online: true;
    in-out property <bool> tailnet-online: true;
    in-out property <string> download: "128.6";
    in-out property <string> upload: "16.4";
    in-out property <string> message;
    in-out property <int> page-revision;
    in-out property <bool> locked: true;
    in-out property <bool> pin-enabled;
    in-out property <bool> pin-visible;
    in-out property <bool> pin-busy;
    in-out property <string> pin-title;
    in-out property <string> pin-message;
    in-out property <string> pin-masked;
    in-out property <int> pin-remaining;
    in-out property <float> hold-progress;
    callback hold-start;
    callback hold-tick;
    callback hold-end(bool);
    callback hold-cancel;
    callback pin-digit(int);
    callback pin-backspace;
    callback pin-submit;
    callback pin-cancel;
    callback pin-setup(bool);
    callback pin-key(string);
    callback lock-now;
    callback navigate(int);
    callback open(string);
    callback back;
    callback action(int);
    callback theme(bool);
    callback accent(string);
    callback set-brightness(int);
    callback cycle-sleep;
    callback power;
    callback activity;
    callback scenario;
    callback exit;
    changed page-revision => { scroll.content-y = 0px; }
    changed asleep => { if root.asleep { focus.focus(); } }
    changed editor-visible => { if !root.editor-visible { focus.focus(); } }
    focus := FocusScope {
        width: parent.width; height: parent.height;
        key-pressed(event) => {
            root.activity();
            if root.pin-visible {
                if event.text == Key.Escape { root.pin-cancel(); }
                else if event.text == Key.Return { root.pin-submit(); }
                else if event.text == Key.Backspace { root.pin-backspace(); }
                else { root.pin-key(event.text); }
                return accept;
            }
            if root.editor-visible {
                if event.text == Key.Escape { root.editor-cancel(); return accept; }
                return reject;
            }
            if root.choice-visible || root.confirm-visible {
                if event.text == Key.Escape { root.choice-cancel(); root.confirm-cancel(); return accept; }
                if event.text == " " { root.power(); return accept; }
                return accept;
            }
            if event.text == " " { root.power(); return accept; }
            if root.locked { return accept; }
            if event.text == Key.Escape { root.back(); return accept; }
            if event.text == Key.RightArrow { root.navigate(mod(root.tab + 1, 4)); return accept; }
            if event.text == Key.LeftArrow { root.navigate(mod(root.tab + 3, 4)); return accept; }
            return reject;
        }
        init => { self.focus(); }
        Rectangle {
            x: 0px; y: 0px; width: parent.width; height: 28px;
            HorizontalLayout {
                padding-left: 14px; padding-right: 14px;
                Label { text: "U60"; font-size: 12px; font-weight: 700; vertical-alignment: center; }
                Label { text: root.connection-label; color: Palette.warning; font-size: 12px; vertical-alignment: center; horizontal-alignment: center; }
                Label { text: root.network-mode + "  ·  " + root.battery; font-size: 12px; vertical-alignment: center; horizontal-alignment: right; }
            }
        }
        Rectangle {
            y: 28px; width: parent.width; height: 62px;
            HorizontalLayout {
                padding-left: 14px; padding-right: 14px; spacing: 8px;
                if root.can-back: Rectangle {
                    width: 36px;
                    Label { text: "‹"; font-size: 32px; vertical-alignment: center; }
                    TouchArea { clicked => { root.back(); } }
                }
                VerticalLayout {
                    padding-top: 3px; padding-bottom: 6px; spacing: 2px;
                    Label { text: root.kicker; height: 17px; font-size: 12px; color: Palette.muted; letter-spacing: 0.5px; }
                    Label { text: root.heading; height: 32px; font-size: 22px; font-weight: 650; }
                }
            }
        }
        scroll := Flickable {
            x: 0px; y: 90px; width: 320px; height: 334px;
            content-width: self.width; content-height: content.height;
            changed content-y => { root.activity(); }
            content := VerticalLayout {
                width: scroll.width; height: self.preferred-height;
                padding-left: 12px; padding-right: 12px; padding-top: 2px; padding-bottom: 12px; spacing: 10px;
                if root.view == 0: TrafficPanel {
                    online: root.network-online; download: root.download; upload: root.upload;
                    network-label: root.radio-label; total: root.traffic-total;
                    interactive: true; clicked => { root.open("traffic"); }
                }
                if root.view == 0: HorizontalLayout {
                    spacing: 10px;
                    Stat { label: @tr("信号强度"); value: root.signal-strength; unit: "dBm"; clicked => { root.open("signal-live"); } }
                    Stat { label: @tr("连接设备"); value: root.client-count; unit: @tr("台设备"); clicked => { root.open("clients"); } }
                }
                if root.view == 0: MenuRow {
                    title: @tr("分享 Wi-Fi"); subtitle: @tr("扫码连接热点，无需输入密码"); tag: @tr("扫码");
                    clicked => { root.open("wifi-share"); }
                }
                if root.view == 0: Rectangle {
                    height: 86px; border-radius: 10px; background: Palette.surface;
                    HorizontalLayout {
                        padding: 14px; spacing: 8px;
                        VerticalLayout {
                            Label { text: "TAILSCALE"; height: 16px; font-size: 12px; color: Palette.muted; }
                            Label { text: root.tailnet-status; height: 24px; font-size: 17px; font-weight: 600; color: root.tailnet-online ? Palette.good : Palette.warning; }
                            Label { text: @tr("子网路由与连通性检测"); height: 18px; font-size: 13px; color: Palette.muted; }
                        }
                        Label { text: "↗"; font-size: 24px; vertical-alignment: center; color: Palette.accent-ink; width: 24px; }
                    }
                    TouchArea { clicked => { root.open("tailscale-network"); } }
                }
                if root.view == 1: VerticalLayout {
                    spacing: 8px;
                    for entry in root.entries: MenuRow { title: entry.title; subtitle: entry.subtitle; tag: entry.tag; clicked => { root.open(entry.id); } }
                }
                if root.view == 2: VerticalLayout {
                    spacing: 10px;
                    if root.description != "": Label { text: root.description; color: Palette.muted; wrap: word-wrap; overflow: clip; }
                    for reading in root.readings: Rectangle {
                        background: Palette.surface; border-radius: 8px; min-height: 58px;
                        VerticalLayout {
                            padding: 12px; spacing: 4px;
                            Label { text: reading.label; font-size: 13px; color: Palette.muted; }
                            Label { text: reading.value; font-size: 14px; wrap: word-wrap; overflow: clip; }
                        }
                    }
                    for entry in root.entries: MenuRow { title: entry.title; subtitle: entry.subtitle; tag: entry.tag; clicked => { root.open(entry.id); } }
                    if root.note != "": Label { text: root.note; color: Palette.muted; font-size: 12px; wrap: word-wrap; overflow: clip; }
                    for action[index] in root.actions: TapButton { text: action; clicked => { root.action(index); } }
                }
                if root.view == 3: VerticalLayout {
                    spacing: 12px;
                    Label { text: "Language / 语言"; color: Palette.muted; font-size: 12px; }
                    HorizontalLayout {
                        spacing: 8px;
                        for language in [{code: "zh-Hans", name: "简体中文"}, {code: "zh-Hant", name: "繁體中文"}]: TapButton {
                            text: language.name; selected: root.language == language.code;
                            clicked => { root.set-language(language.code); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        for language in [{code: "en", name: "English"}, {code: "ja", name: "日本語"}, {code: "ko", name: "한국어"}]: TapButton {
                            text: language.name; selected: root.language == language.code;
                            clicked => { root.set-language(language.code); }
                        }
                    }
                    Label { text: @tr("界面主题"); color: Palette.muted; font-size: 12px; }
                    HorizontalLayout {
                        spacing: 10px;
                        TapButton { text: @tr("浅色"); selected: !Palette.dark; clicked => { root.theme(false); } }
                        TapButton { text: @tr("深色"); selected: Palette.dark; clicked => { root.theme(true); } }
                    }
                    Label { text: @tr("强调色"); color: Palette.muted; font-size: 12px; }
                    HorizontalLayout {
                        spacing: 5px;
                        for swatch in [
                            { color: #2563eb, hex: "#2563eb" }, { color: #0891b2, hex: "#0891b2" },
                            { color: #258052, hex: "#258052" }, { color: #d97706, hex: "#d97706" },
                            { color: #db3d70, hex: "#db3d70" }, { color: #64748b, hex: "#64748b" }
                        ]: Rectangle {
                            height: 44px; border-radius: 8px; background: swatch.color;
                            border-width: swatch.color == Palette.accent ? 3px : 0px; border-color: Palette.text;
                            TouchArea { clicked => { root.accent(swatch.hex); } }
                        }
                    }
                    MenuRow { title: @tr("自定义颜色"); subtitle: root.accent-hex; clicked => { root.edit("accent"); } }
                    Label { text: @tr("屏幕亮度  ") + root.brightness + "%"; color: Palette.muted; font-size: 12px; }
                    Brightness { value: root.brightness; changed(value) => { root.set-brightness(value); } }
                    MenuRow { title: @tr("自动熄屏"); subtitle: root.sleep-label; clicked => { root.cycle-sleep(); } }
                    TapButton { text: @tr("熄屏"); clicked => { root.power(); } }
                    Label { text: @tr("明暗、配色与亮度即时生效。"); color: Palette.muted; font-size: 12px; }
                }
                if root.view == 4: VerticalLayout {
                    spacing: 10px;
                    Rectangle {
                        height: 108px; background: Palette.surface; border-radius: 12px;
                        VerticalLayout {
                            padding: 16px; spacing: 8px;
                            Label { text: @tr("U60   →   Tailscale   →   目标"); font-size: 13px; color: Palette.accent-ink; }
                            Label { text: root.tailnet-status; font-size: 20px; font-weight: 600; }
                            Label { text: @tr("子网路由与连通性检测"); font-size: 12px; color: Palette.muted; }
                        }
                    }
                    if !root.demo: MenuRow { title: @tr("检测目标"); subtitle: root.probe-target == "" ? @tr("设置目标 IP 和端口") : root.probe-target; clicked => { root.edit("probe-target"); } }
                    for row in root.tailnet-readings: Rectangle {
                        min-height: 64px; background: Palette.surface; border-radius: 8px;
                        VerticalLayout {
                            padding: 12px; spacing: 4px;
                            Label { text: row.label; color: Palette.muted; font-size: 13px; }
                            Label { text: row.value; wrap: word-wrap; overflow: clip; }
                        }
                    }
                    if root.demo: TapButton { text: @tr("切换演示场景"); clicked => { root.scenario(); } }
                    if !root.demo: TapButton { text: @tr("刷新连接状态"); clicked => { root.refresh(); } }
                    Label { text: root.demo ? @tr("当前读数为演示数据。") : root.probe-note; color: Palette.muted; font-size: 13px; wrap: word-wrap; }
                }
                if root.view == 6: VerticalLayout {
                    spacing: 12px;
                    Label { text: @tr("后台连接 · ") + root.connection-label; font-size: 18px; }
                    Label { text: @tr("机身屏幕使用本机后台账号连接。也可以输入后台密码重新登录。"); color: Palette.muted; wrap: word-wrap; }
                    TapButton { text: @tr("输入密码登录"); selected: true; clicked => { root.edit("agent-login"); } }
                    TapButton { text: @tr("重新连接"); clicked => { root.refresh(); } }
                    TapButton { text: @tr("断开并清除本地会话"); clicked => { root.agent-forget(); } }
                }
                if root.view == 5: VerticalLayout {
                    spacing: 12px;
                    MenuRow { title: @tr("密码解锁"); subtitle: root.pin-enabled ? @tr("已开启 · 6–12 位数字密码") : @tr("未开启 · 仅长按解锁"); clicked => { root.pin-setup(false); } }
                    TapButton { text: root.pin-enabled ? @tr("修改解锁密码") : @tr("设置解锁密码"); clicked => { root.pin-setup(false); } }
                    if root.pin-enabled: TapButton { text: @tr("关闭密码解锁"); clicked => { root.pin-setup(true); } }
                    TapButton { text: @tr("立即锁屏"); clicked => { root.lock-now(); } }
                    Label { text: @tr("启动与熄屏后自动锁定。开启密码后，更改或关闭密码需要先验证当前密码。"); font-size: 14px; color: Palette.muted; wrap: word-wrap; }
                    if root.pin-message != "": Label { text: root.pin-message; color: Palette.good; wrap: word-wrap; }
                }
                if root.view == 7: VerticalLayout {
                    spacing: 8px;
                    if root.feature-notice != "": Label { text: root.feature-notice; color: Palette.warning; wrap: word-wrap; overflow: clip; font-size: 14px; }
                    if root.feature-has-qr && root.feature-qr-caption != "": Label {
                        text: root.feature-qr-caption; font-size: 17px; font-weight: 600; horizontal-alignment: center; wrap: word-wrap;
                    }
                    if root.feature-has-qr: HorizontalLayout {
                        alignment: center;
                        Image { source: root.feature-qr; width: 256px; height: 256px; image-fit: contain; horizontal-stretch: 0; }
                    }
                    for row in root.readings: Rectangle {
                        min-height: 62px; background: Palette.surface; border-radius: 8px;
                        VerticalLayout {
                            padding: 12px; spacing: 4px;
                            Label { text: row.label; color: Palette.muted; font-size: 13px; }
                            Label { text: row.value; wrap: word-wrap; overflow: clip; }
                        }
                    }
                    if root.feature-content != "": Rectangle {
                        background: Palette.surface; border-radius: 8px;
                        VerticalLayout { padding: 12px; Label { text: root.feature-content; font-size: 16px; wrap: word-wrap; overflow: clip; } }
                    }
                    for field in root.feature-fields: MenuRow {
                        title: field.title; subtitle: field.subtitle; tag: field.tag;
                        clicked => { root.feature-edit(field.index); }
                    }
                    for entry in root.entries: MenuRow { title: entry.title; subtitle: entry.subtitle; tag: entry.tag; clicked => { root.open(entry.id); } }
                    for action[index] in root.feature-actions: TapButton {
                        text: action.label; interactive: action.enabled && !root.feature-busy;
                        clicked => { root.feature-action(index); }
                    }
                    TapButton { text: root.feature-busy ? @tr("正在处理…") : @tr("刷新状态"); interactive: !root.feature-busy; clicked => { root.feature-refresh(); } }
                    if root.note != "": Label { text: root.note; font-size: 13px; color: Palette.muted; wrap: word-wrap; overflow: clip; }
                }
            }
        }
        Rectangle {
            y: 424px; height: 56px; width: parent.width; background: Palette.surface;
            Rectangle { x: 0px; y: 0px; height: 1px; width: parent.width; background: Palette.line; }
            HorizontalLayout {
                for name[index] in [@tr("概览"), @tr("网络"), @tr("应用"), @tr("设备")]: Rectangle {
                    width: 80px;
                    VerticalLayout {
                        padding-top: 8px; padding-bottom: 8px; spacing: 2px;
                        Label { text: "0" + (index + 1); height: 16px; color: root.tab == index ? Palette.accent-ink : Palette.muted; font-size: 12px; horizontal-alignment: center; }
                        Label { text: name; height: 20px; color: root.tab == index ? Palette.accent-ink : Palette.muted; font-size: root.language == "ja" ? 13px : 14px; font-weight: root.tab == index ? 650 : 500; horizontal-alignment: center; }
                    }
                    if root.tab == index: Rectangle { x: (parent.width - 18px) / 2; y: 0px; height: 2px; width: 18px; background: Palette.accent; }
                    TouchArea { clicked => { root.navigate(index); } }
                }
            }
        }
        if root.choice-visible: Rectangle {
            width: parent.width; height: parent.height; background: Palette.bg;
            TouchArea { }
            Label { x: 12px; y: 12px; width: 296px; height: 36px; text: root.choice-title; font-size: 22px; font-weight: 650; }
            Flickable {
                x: 12px; y: 58px; width: 296px; height: 352px; content-width: self.width; content-height: options.height;
                options := VerticalLayout {
                    width: 296px; height: self.preferred-height; spacing: 8px;
                    for choice[index] in root.choices: MenuRow { title: choice.title; subtitle: choice.subtitle; tag: choice.tag; clicked => { root.choose(index); } }
                }
            }
            TapButton { x: 12px; y: 424px; width: 296px; height: 44px; text: @tr("取消"); clicked => { root.choice-cancel(); } }
        }
        if root.confirm-visible: Rectangle {
            width: parent.width; height: parent.height; background: Palette.bg;
            TouchArea { }
            Label { x: 12px; y: 12px; width: 296px; height: 36px; text: @tr("确认操作"); font-size: 22px; font-weight: 650; }
            Flickable {
                x: 12px; y: 58px; width: 296px; height: root.confirm-phrase == "" ? 348px : 280px;
                content-width: self.width; content-height: confirmation-text.height;
                confirmation-text := Label { width: 296px; text: root.confirm-body; wrap: word-wrap; overflow: clip; font-size: 16px; }
            }
            if root.confirm-phrase != "": MenuRow {
                x: 12px; y: 342px; width: 296px;
                title: @tr("输入 ") + root.confirm-phrase + @tr(" 确认"); subtitle: root.confirm-word;
                clicked => { root.edit("confirmation"); }
            }
            HorizontalLayout {
                x: 12px; y: 424px; width: 296px; height: 44px; spacing: 8px;
                TapButton { text: @tr("取消"); clicked => { root.confirm-cancel(); } }
                TapButton { text: @tr("确认执行"); selected: true; interactive: root.confirm-word == root.confirm-phrase; clicked => { root.confirm-accept(); } }
            }
        }
        if root.message != "": Rectangle {
            width: parent.width; height: parent.height; background: #000000a0;
            TouchArea { }
            Rectangle {
                x: 16px; y: (parent.height - self.height) / 2; width: 288px;
                background: Palette.surface; border-radius: 12px;
                VerticalLayout {
                    padding: 18px; spacing: 16px;
                    Label { text: @tr("提示"); font-size: 20px; font-weight: 600; }
                    Label { text: root.message; wrap: word-wrap; overflow: clip; }
                    TapButton { text: @tr("知道了"); selected: true; clicked => { root.message = ""; } }
                }
            }
        }
        if root.editor-visible && !root.locked && !root.pin-visible: TextEditor {
            width: parent.width; height: parent.height;
            title: root.editor-title; hint: root.editor-hint; error: root.editor-error;
            value <=> root.editor-value; secret: root.editor-secret; layout <=> root.editor-layout;
            multiline: root.editor-multiline;
            key(value) => { root.editor-key(value); }
            submit => { root.editor-submit(); }
            cancel => { root.editor-cancel(); }
            activity => { root.activity(); }
        }
        if root.locked && !root.pin-visible: LockScreen {
            width: parent.width; height: parent.height;
            pin-enabled: root.pin-enabled; awake: !root.asleep; progress: root.hold-progress;
            battery: root.battery; network-online: root.network-online;
            connection-label: root.connection-label; radio-label: root.radio-label;
            signal-strength: root.signal-strength; traffic-total: root.traffic-total;
            download: root.download; upload: root.upload;
            hold-start => { root.hold-start(); }
            hold-tick => { root.hold-tick(); }
            hold-end(inside) => { root.hold-end(inside); }
            hold-cancel => { root.hold-cancel(); }
        }
        if root.pin-visible: PinPad {
            width: parent.width; height: parent.height;
            title: root.pin-title; message: root.pin-message; masked: root.pin-masked;
            busy: root.pin-busy; remaining: root.pin-remaining;
            digit(n) => { root.pin-digit(n); }
            backspace => { root.pin-backspace(); }
            submit => { root.pin-submit(); }
            cancel => { root.pin-cancel(); }
        }
        if root.asleep: Rectangle {
            width: parent.width; height: parent.height; background: #000000;
            TouchArea { clicked => { root.power(); } }
        }
    }
}
